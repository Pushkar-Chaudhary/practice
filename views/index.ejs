<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Board</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-6">
        <div class="form max-w-xl mx-auto mb-8">
            <form action="/create" method="post">
                <input class="block px-5 w-full rounded py-2 bg-zinc-800 text-white mb-3" type="text" placeholder="Title goes here" name="title">
                <textarea class="block px-5 py-2 resize-none bg-zinc-800 text-white w-full rounded" placeholder="Write your task details" name="details"></textarea>
                <input type="submit" value="Create task" class="mt-3 bg-blue-600 px-5 py-2 rounded text-white cursor-pointer">
            </form>
        </div>

        <div class="tasks p-4 flex gap-3 flex-wrap justify-center">
            <% if (files && files.length > 0) { %>
                <% files.forEach(function(file) { %>
                    <div class="task w-72 px-4 py-4 rounded-md bg-zinc-800 shadow-md">
                        <h1 class="text-white text-2xl tracking-tight mb-2"><%= file %></h1>
                        <a href="/task/<%= encodeURIComponent(file) %>" class="text-blue-500">Read More</a>
                        <a href="/edit/<%= encodeURIComponent(file) %>" class="text-blue-500 ml-2">Edit</a>
                    </div>
                <% }) %>
            <% } else { %>
                <h3 class="text-white text-xl">No tasks yet.</h3>
            <% } %>
        </div>
    </div>
</body>
</html>